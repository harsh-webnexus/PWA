# BACKEND — server secrets (never commit service-account.json)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
FCM_SERVER_PORT=3001
FCM_TEST_TITLE=Hello from FCM
FCM_TEST_BODY=This is a test notification
FCM_TEST_LINK=/

# This project uses Firebase Cloud Messaging for Web Push (not a separate web-push VAPID pair).
# The browser VAPID public key lives only in frontend/.env as VITE_FIREBASE_VAPID_KEY.
# Admin credentials are in service-account.json — never put private keys in VITE_* vars.
